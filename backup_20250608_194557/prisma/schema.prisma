generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- MODELS ---
model User {
  id                    String   @id @default(cuid())
  userId                String   @unique
  firstName             String
  lastName              String
  name                  String
  email                 String   @unique
  username              String?  @unique
  password              String
  phone                 String?  @unique
  role                  String
  sex                   String?
  dateOfBirth           DateTime?
  isVerified            Boolean  @default(false)
  emailVerificationCode String?
  phoneVerificationCode String?
  verificationMethod    String?
  
  // Profile completion tracking
  profileCompleted      Boolean  @default(false)
  lastLoginAt           DateTime?
  passwordChangedAt     DateTime?
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  // Relations
  preferences           UserPreferences?
  casesAsPatient        Case[]   @relation("PatientCases")
  casesAsDentist        Case[]   @relation("DentistCases")
  casesAsReviewer       Case[]   @relation("ReviewerCases")
  casesAsManufacturer   Case[]   @relation("ManufacturerCases")
  appointments          Appointment[]
  notifications         Notification[]
  payments              Payment[]
  logs                  Log[]
  clinics               Clinic[]
  caseNotes             CaseNote[]
  sessions              Session[]
}

// New: User preferences model
model UserPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Notification preferences
  emailNotifications    Boolean  @default(true)
  smsNotifications      Boolean  @default(false)
  appointmentReminders  Boolean  @default(true)
  caseUpdateAlerts      Boolean  @default(true)
  marketingEmails       Boolean  @default(false)
  
  // Display preferences
  language              String   @default("en")
  timezone              String   @default("America/New_York")
  dateFormat            String   @default("MM/DD/YYYY")
  timeFormat            String   @default("12h")
  darkMode              Boolean  @default(false)
  
  // Dentist-specific preferences
  defaultClinicId       String?
  autoArchiveDays       Int      @default(90) // Auto-archive completed cases after X days
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([userId])
}

// New: Session tracking for security
model Session {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         String   @unique
  ipAddress     String?
  userAgent     String?
  lastActivity  DateTime
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  
  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model Case {
  id               String      @id @default(cuid())
  caseNumber       String      @unique
  patientId        String
  patient          User        @relation("PatientCases", fields: [patientId], references: [id], onDelete: Cascade)
  dentist          User        @relation("DentistCases", fields: [dentistId], references: [id], onDelete: Cascade)
  dentistId        String
  
  status           String      @default("PENDING_REVIEW")
  priority         String      @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  
  reviewer         User?       @relation("ReviewerCases", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerId       String?
  reviewedAt       DateTime?
  
  manufacturer     User?       @relation("ManufacturerCases", fields: [manufacturerId], references: [id], onDelete: SetNull)
  manufacturerId   String?
  manufacturingStartedAt DateTime?

  // Patient snapshot fields
  patientFirstName String
  patientLastName  String
  patientEmail     String
  patientPhone     String?
  patientSex       String
  patientDOB       DateTime

  // File uploads - using JSON for flexibility
  upperScanFile    String?
  lowerScanFile    String?
  biteScanFile     String?
  treatmentPlanUrl String?
  scanFileUrl      String?     // JSON string for additional files
  
  // Treatment details
  treatmentType    String      @default("STANDARD") // STANDARD, EXPRESS, COMPLEX
  estimatedWeeks   Int?
  actualWeeks      Int?
  
  // Consent and timeline
  patientConsented Boolean     @default(false)
  consentedAt      DateTime?
  treatmentStartedAt DateTime?
  treatmentCompletedAt DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  
  // Financial
  totalCost        Decimal?
  paidAmount       Decimal     @default(0)
  paymentStatus    String      @default("PENDING") // PENDING, PARTIAL, PAID, REFUNDED
  
  notes            String?
  internalNotes    String?     // Notes only visible to staff
  hiddenByDentist  Boolean     @default(false)
  archivedByDentist Boolean   @default(false)
  archivedAt       DateTime?
  
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  appointments     Appointment[]
  payments         Payment[]
  caseNotes        CaseNote[]
  activities       CaseActivity[]
  
  @@index([archivedByDentist])
  @@index([dentistId])
  @@index([patientId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

// New: Track case activities separately for better performance
model CaseActivity {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId      String?
  userName    String
  action      String   // STATUS_CHANGED, FILE_UPLOADED, NOTE_ADDED, etc.
  details     String?  // JSON string with additional details
  metadata    String?  // JSON for any extra data
  createdAt   DateTime @default(now())
  
  @@index([caseId])
  @@index([action])
  @@index([createdAt])
}

model Appointment {
  id          String    @id @default(cuid())
  case        Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  
  // Patient details (denormalized for performance)
  patientId   String?
  patientName String?
  
  date        DateTime
  duration    Int       @default(30) // Duration in minutes
  clinicId    String?
  clinic      Clinic?   @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  clinicName  String?
  
  type        String    @default("FOLLOW_UP") // CONSULTATION, FOLLOW_UP, TREATMENT, EMERGENCY
  reason      String?
  notes       String?
  
  status      String    @default("SCHEDULED")
  
  // Tracking
  confirmedAt DateTime?
  checkedInAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  cancelReason String?
  noShowAt    DateTime?
  
  // Reminders
  reminderSent Boolean  @default(false)
  reminderSentAt DateTime?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([caseId])
  @@index([userId])
  @@index([patientId])
  @@index([date])
  @@index([status])
  @@index([clinicId])
}

model CaseNote {
  id          String   @id @default(cuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  content     String
  category    String   @default("general") // general, clinical, administrative, financial
  isInternal  Boolean  @default(true)
  
  // Link to appointment if note was created during/after appointment
  appointmentId String?
  
  attachments String?  // JSON array of file paths
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  editedAt    DateTime?
  
  @@index([caseId])
  @@index([userId])
  @@index([category])
  @@index([createdAt])
}

model Clinic {
  id           String        @id @default(cuid())
  name         String
  address      String?
  city         String?
  state        String?
  zipCode      String?
  country      String        @default("USA")
  phone        String?
  email        String?
  website      String?
  
  // Operating hours (JSON string)
  operatingHours String?     // e.g., {"monday": {"open": "09:00", "close": "17:00"}, ...}
  
  // Features
  isActive     Boolean       @default(true)
  acceptsWalkIns Boolean     @default(false)
  
  dentistId    String
  dentist      User          @relation(fields: [dentistId], references: [id], onDelete: Cascade)
  
  appointments Appointment[]
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  
  @@index([dentistId])
  @@index([isActive])
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  
  title     String?
  message   String
  type      String   @default("info") // info, success, warning, error, appointment, case_update
  category  String?  // system, case, appointment, payment, etc.
  
  // Action link
  actionUrl String?
  actionLabel String?
  
  read      Boolean  @default(false)
  readAt    DateTime?
  
  // Email/SMS tracking
  emailSent Boolean  @default(false)
  smsSent   Boolean  @default(false)
  
  metadata  String?  // JSON for additional data
  expiresAt DateTime?
  
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([read])
  @@index([type])
  @@index([createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  case        Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId      String
  
  amount      Decimal
  currency    String        @default("USD")
  
  status      String        @default("PENDING")
  method      String?       // credit_card, debit_card, bank_transfer, cash, insurance
  
  // Payment gateway info
  transactionId String?
  gatewayResponse String?   // JSON response from payment gateway
  
  description String?
  notes       String?
  
  // Refund tracking
  refundedAmount Decimal?
  refundedAt     DateTime?
  refundReason   String?
  
  paidAt      DateTime?
  failedAt    DateTime?
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  @@index([userId])
  @@index([caseId])
  @@index([status])
  @@index([createdAt])
}

model Log {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action     String
  targetType String   // USER, CASE, APPOINTMENT, PAYMENT, CLINIC, SYSTEM
  targetId   String?
  
  details    String?  // Human-readable description
  metadata   String?  // JSON for structured data
  
  ipAddress  String?
  userAgent  String?
  
  severity   String   @default("info") // debug, info, warning, error, critical
  
  createdAt  DateTime @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([targetType])
  @@index([severity])
  @@index([createdAt])
}

model SystemConfig {
  id              String   @id @default("config")
  
  // Security
  adminPin        String   @default("1234")
  sessionTimeout  Int      @default(30) // minutes
  maxLoginAttempts Int     @default(5)
  
  // Business rules
  autoArchiveDays Int      @default(90)
  reminderDays    Int      @default(2) // Send reminders X days before appointment
  
  // Feature flags
  maintenanceMode Boolean  @default(false)
  registrationOpen Boolean @default(true)
  
  // System info
  version         String   @default("1.0.0")
  lastBackup      DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}