{
  "name": "@dental/core",
  "version": "1.0.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./domain/*": {
      "types": "./src/domain/*/index.ts",
      "default": "./src/domain/*/index.ts"
    },
    "./domain/errors": {
      "types": "./src/domain/errors/index.ts",
      "default": "./src/domain/errors/index.ts"
    },
    "./application/*": {
      "types": "./src/application/*/index.ts",
      "default": "./src/application/*/index.ts"
    },
    "./infrastructure/*": {
      "types": "./src/infrastructure/*/index.ts",
      "default": "./src/infrastructure/*/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@dental/database": "workspace:*",
    "@dental/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}