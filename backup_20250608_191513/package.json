{
  "name": "aligner-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run setup:uploads && next dev",
    "dev:turbo": "npm run setup:uploads && next dev --turbopack",
    "build": "npm run setup:uploads && next build",
    "start": "next start",
    "lint": "next lint",
    "setup:uploads": "node scripts/setup-uploads.js",
    "postinstall": "prisma generate && npm run setup:uploads",
    "check:project": "node check-project.js",
    "check:files": "ls -la public/uploads/cases 2>/dev/null || echo 'Upload directory missing'",
    "fix:uploads": "mkdir -p public/uploads/cases && chmod -R 755 public/uploads"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.4",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^6.8.2",
    "@types/three": "^0.160.0",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "next": "^15.3.3",
    "next-auth": "^4.24.11",
    "prisma": "^6.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.5.2",
    "three": "^0.128.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.57",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "file-loader": "^6.2.0",
    "node-fetch": "^2.7.0",
    "postcss": "^8.5.4",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  }
}
